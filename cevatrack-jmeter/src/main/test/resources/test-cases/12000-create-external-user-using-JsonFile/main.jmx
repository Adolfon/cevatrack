        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="[JSR223] - Get JSON Data From Response" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.*
    def json = null
try {
    json = new groovy.json.JsonSlurper().parse(prev.getResponseData())
   def users = json.users
	vars.putObject(&quot;noOfUsers&quot;, users.size())
	vars.putObject(&quot;users&quot;, users)
}
catch (Exception ex) {
    log.info(&quot;Invalid JSON&quot; + ex)        
}
boolean valid = json != null;
log.info(&quot;Testing1&quot;)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
