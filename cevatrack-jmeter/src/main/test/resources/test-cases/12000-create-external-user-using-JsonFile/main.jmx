          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="[JSR223 Sampler] - Assign User Value To Varaiable" enabled="true">
            <stringProp name="cacheKey">false</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">def users = vars.getObject(&quot;users&quot;)
def user = users.get(${counterValue}).user
vars.putObject(&quot;userType&quot;, user[&apos;internal&apos;])
vars.putObject(&quot;emailId&quot;, user[&apos;emailId&apos;])
vars.putObject(&quot;firstName&quot;, user[&apos;firstName&apos;])
vars.putObject(&quot;lastName&quot;, user[&apos;lastName&apos;])
vars.putObject(&quot;loginId&quot;, user[&apos;loginId&apos;])
vars.putObject(&quot;userPassword&quot;, user[&apos;password&apos;])</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Sampler>
          <hashTree/>
