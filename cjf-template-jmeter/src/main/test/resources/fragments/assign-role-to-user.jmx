          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="[JSR223] Add Roles to HTTP Parameters" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">log.info(&quot;Your message here&quot;);
def roleIdList = vars.getObject(&quot;roleIdList&quot;)

roleIdList.each {
    log.info(&quot;Adding role $it&quot;)
    sampler.addArgument(&quot;aaf_user:userRoleForm:pkl_user_role_target&quot;,&quot;${it}&quot;)
}

</stringProp>
