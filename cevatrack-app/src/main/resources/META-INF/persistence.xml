<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.0"
             xmlns="http://java.sun.com/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://java.sun.com/xml/ns/persistence
                                 http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd">

    <persistence-unit name="cevatrackPU" transaction-type="JTA">
        <provider>org.apache.openjpa.persistence.PersistenceProviderImpl</provider>
<!--    <jta-data-source>java:openejb/Resource/templateDS</jta-data-source>
        <class>com.ceva.template.domain.Todo</class>   -->        
        <jta-data-source>java:openejb/Resource/cevatrackDS</jta-data-source>
		<class>com.ceva.cevatrack.domain.AbstractEntity</class>
		<class>com.ceva.cevatrack.domain.SmartNetClient</class>
		<class>com.ceva.cevatrack.domain.SmartNetClientTest</class>
		<class>com.ceva.cevatrack.domain.User</class>
		<class>com.ceva.cevatrack.domain.OrderLookUp</class>
		<class>com.ceva.cevatrack.domain.AAFUser4Nike</class>
		<class>com.ceva.cevatrack.domain.ClientsAPI</class>
		<class>com.ceva.cevatrack.domain.SEBOrder</class>
		<class>com.ceva.cevatrack.domain.Tracking_reference_suspense</class>
        <properties>
            <property name="show_sql" value="true"/>
            <property name="openejb.jpa.auto-scan" value="true"/>
            <property name="openejb.jpa.init-entitymanager" value="true"/>
            <!-- <property name="openjpa.jdbc.SynchronizeMappings" value="buildSchema(ForeignKeys=true)"/> -->
            <property name="openjpa.Log" value="DefaultLevel=WARN, Runtime=INFO, Tool=WARN, SQL=WARN"/>
            <!--<property name="openjpa.jdbc.DBDictionary" value="SupportsMultipleNontransactionalResultSets=false,RequiresAutoCommitForMetaData=false"/>-->
        </properties>
    </persistence-unit>
     <persistence-unit name="cevatrackPULocal" transaction-type="RESOURCE_LOCAL">
        <provider>org.apache.openjpa.persistence.PersistenceProviderImpl</provider>
<!--    <jta-data-source>java:openejb/Resource/templateDS</jta-data-source>
        <class>com.ceva.template.domain.Todo</class>   -->        
        <non-jta-data-source>java:openejb/Resource/cevatrackDSLocal</non-jta-data-source>
		<class>com.ceva.cevatrack.domain.AbstractEntity</class>
		<class>com.ceva.cevatrack.domain.SmartNetClient</class>
		<class>com.ceva.cevatrack.domain.SmartNetClientTest</class>
		<class>com.ceva.cevatrack.domain.User</class>
		<class>com.ceva.cevatrack.domain.OrderLookUp</class>
		<class>com.ceva.cevatrack.domain.AAFUser4Nike</class>
		<class>com.ceva.cevatrack.domain.ClientsAPI</class>
		<class>com.ceva.cevatrack.domain.SEBOrder</class>
		<class>com.ceva.cevatrack.domain.Tracking_reference_suspense</class>
        <properties>
            <property name="show_sql" value="true"/>
            <property name="openejb.jpa.auto-scan" value="true"/>
            <property name="openejb.jpa.init-entitymanager" value="true"/>
            <!-- <property name="openjpa.jdbc.SynchronizeMappings" value="buildSchema(ForeignKeys=true)"/> -->
            <property name="openjpa.Log" value="DefaultLevel=WARN, Runtime=INFO, Tool=WARN, SQL=WARN"/>
            <!--<property name="openjpa.jdbc.DBDictionary" value="SupportsMultipleNontransactionalResultSets=false,RequiresAutoCommitForMetaData=false"/>-->
        </properties>
    </persistence-unit>
</persistence>